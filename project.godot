; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bugsplat"
run/main_scene="uid://uv5kig2w3h2p"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://ch7xqkmg1f0sm"

[audio]

buses/default_bus_layout="uid://call2a5402do5"

[autoload]

PlatformManager="*uid://dfg1obpblo8rj"
CustomErrors="*uid://lpm5etmqwbgu"
SFX="*uid://ccj5oje5x2ftn"
SceneManager="*uid://b8bcwim3yl6vu"
GameManager="*uid://onbpgd444ymx"
SaveManager="*uid://bl4vjepm2y78a"
MessageBus="*uid://cjl85v1f0g178"
MusicPlayer="*uid://tcar224h5tkw"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg")

[global_group]

growable_tiles=""
camera_area=""
Player=""
warmup_particles=""

[gui]

theme/custom_font="uid://cc5c14wgp2sxk"

